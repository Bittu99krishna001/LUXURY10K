import React, { useState } from 'react';
import { StyleSheet, Text, View, TextInput, TouchableOpacity, Alert, Image } from 'react-native';
import { STORE_NAME, API_BASE_URL } from '../shared/config';

export default function MobileApp() {
  const [phone, setPhone] = useState('');
  const [password, setPassword] = useState('');

  const handleLogin = () => {
    if (!phone || !password) {
      Alert.alert("एरर", "कृपया मोबाइल नंबर और पासवर्ड भरें हुकुम!");
      return;
    }
    Alert.alert("सफलता", `${STORE_NAME} में आपका स्वागत है हुकुम!`);
  };

  return (
    <View style={styles.container}>
      {/* 👈 'LS' (Logo)*/}
      <View style={styles.logoContainer}>
        <Image 
          source={require('../assets/logo.png')} 
          style={styles.logoImage} 
          resizeMode="contain"
        />
      </View>
      
      <Text style={styles.title}>LuxuryStore</Text>
      <Text style={styles.subtitle}>वेंडर मोबाइल पोर्टल</Text>

      <TextInput
        style={styles.input}
        placeholder="मोबाइल नंबर डालें"
        placeholderTextColor="#888"
        keyboardType="phone-pad"
        value={phone}
        onChangeText={setPhone}
      />

      <TextInput
        style={styles.input}
        placeholder="पासवर्ड डालें"
        placeholderTextColor="#888"
        secureTextEntry={true}
        value={password}
        onChangeText={setPassword}
      />

      <TouchableOpacity style={styles.button} onPress={handleLogin}>
        <Text style={styles.buttonText}>लॉगिन करें</Text>
      </TouchableOpacity>
    </View>
  );
}

